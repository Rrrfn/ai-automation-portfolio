{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Every 1 Hour Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "url": "https://cointelegraph.com/rss"
      },
      "id": "2",
      "name": "Fetch Crypto RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "operation": "removeDuplicates",
        "compare": "selectedFields",
        "fieldsToCompare": "link"
      },
      "id": "3",
      "name": "Remove Duplicate News",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [620, 300]
    },
    {
      "parameters": {
        "maxItems": 3
      },
      "id": "4",
      "name": "Limit to Top 3 Items",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [840, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Analyze this news item. Respond ONLY with a JSON object containing: summary (string), sentiment (Bullish|Bearish|Neutral), impact_score (number 1-100), tags (array of strings).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Title: {{ $json.title }}\"\n    }\n  ]\n}"
      },
      "id": "5",
      "name": "Groq AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  try {\n    const aiContent = item.json.choices[0].message.content;\n    const parsed = JSON.parse(aiContent);\n    item.json.telegram_formatted = `<b>${item.json.title}</b>\\n\\n${parsed.summary}\\n\\nImpact: ${parsed.impact_score}/100`;\n    item.json.should_publish = (parsed.impact_score || 50) >= 40;\n  } catch (e) {\n    item.json.telegram_formatted = `<b>${item.json.title}</b>`;\n    item.json.should_publish = true;\n  }\n}\nreturn $input.all();"
      },
      "id": "6",
      "name": "Parse & Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.should_publish }}",
              "value2": true
            }
          ]
        }
      },
      "id": "7",
      "name": "Filter High Impact News",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "chatId": "@your_channel_username",
        "text": "={{ $json.telegram_formatted }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "8",
      "name": "Broadcast to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1720, 300]
    }
  ],
  "connections": {
    "Every 1 Hour Trigger": {
      "main": [
        [
          {
            "node": "Fetch Crypto RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Crypto RSS": {
      "main": [
        [
          {
            "node": "Remove Duplicate News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remove Duplicate News": {
      "main": [
        [
          {
            "node": "Limit to Top 3 Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Limit to Top 3 Items": {
      "main": [
        [
          {
            "node": "Groq AI Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq AI Analysis": {
      "main": [
        [
          {
            "node": "Parse & Format Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse & Format Output": {
      "main": [
        [
          {
            "node": "Filter High Impact News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter High Impact News": {
      "main": [
        [
          {
            "node": "Broadcast to Telegram",
