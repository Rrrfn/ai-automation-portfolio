# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TOKEN

# Groq API Configuration
# Obtain your API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Network / Proxy Settings (Optional)
# Set your local proxy URL if required (e.g., http://127.0.0.1:8080 or http://127.0.0.1:10809)
PROXY_URL=http://127.0.0.1:8080
